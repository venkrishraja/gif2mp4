{
  "name": "Save RedGIFs & Imgur GIFs as MP4",
  "description": "Download all open RedGIFs and Imgur GIF tabs as MP4 files.",
  "version": "2.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "logo.png",
    "default_title": "Save GIFs as MP4"
  },
  "permissions": [
    "downloads",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "https://api.redgifs.com/*"
  ]
}
